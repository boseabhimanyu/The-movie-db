MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=<db_name>
PORT=<serverport>
JWT_SECRET=<secret_long_string>
JWT_EXPIRY_HOURS=24
GIN_MODE=debug
# or release
#ALLOWED_ORIGINS=http://localhost:<frontend-serverport>
AUTH_ACCESS_COOKIE=access_token
AUTH_REFRESH_COOKIE=refresh_token

REFRESH_TOKEN_EXPIRY_DAYS=30
REFRESH_TOKEN_REVOKED_RETENTION_DAYS=7
REFRESH_TOKEN_EXPIRED_RETENTION_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TOTP_ISSUER=Basic App
TOTP_ENCRYPTION_KEY=<32-byte-secret>
BACKUP_CODE_COUNT=10
BACKUP_CODE_LOW_THRESHOLD=4

TRAKT_CLIENT_ID=your_trakt_client_id
FANART_API_KEY=your_fanart_api_key
MEDIA_CACHE_TTL_HOURS=240
MEDIA_BATCH_SYNC_LIMIT=8
MEDIA_FEED_CACHE_TTL_MINUTES=15
PERSON_CACHE_TTL_HOURS=168

FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=<your-brevo-smtp-login>
SMTP_PASSWORD=<your-brevo-smtp-key>
SMTP_FROM_EMAIL=<your-verified-sender@yourdomain.com>
SMTP_FROM_NAME=Movie App

EMAIL_VERIFICATION_EXPIRY_HOURS = 24
EMAIL_VERIFICATION_RESEND_MIN_SECONDS = 60
PASSWORD_RESET_EXPIRY_MINUTES = 15
PASSWORD_RESET_RESEND_SECONDS = 60
